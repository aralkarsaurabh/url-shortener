PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5440/url_shortener
REDIS_URL=redis://localhost:6380
CACHE_TTL_SECONDS=3600
NOT_FOUND_TTL_SECONDS=30
LEASE_TTL_MS=5000
FLUSH_INTERVAL_MS=5000
FLUSH_MAX_CLICKS=1000
RATE_LIMIT_CREATE_PER_MINUTE=10
RATE_LIMIT_LOOKUP_PER_MINUTE=300
TRUST_PROXY=false
BLOOM_EXPECTED_CODES=1000000
BLOOM_FALSE_POSITIVE_RATE=0.01
BLOOM_CHECK_INTERVAL_MS=30000
ENABLE_DEBUG=false
